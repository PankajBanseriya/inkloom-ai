# ===================================================================
# Inkloom AI Backend Configuration Example
# ===================================================================

# Server Port
PORT=8080

# MongoDB Connection (Local or Atlas)
MONGODB_URI=mongodb://localhost:27017/inkloom

# JWT Security
INKLOOM_JWT_SECRET=inkloom_development_secret_key_minimum_256_bits_for_hmac_sha256_secure_key_12345
INKLOOM_JWT_EXPIRATION_MS=86400000

# Google Gemini AI Integration (Official Google Gen AI Java SDK: com.google.genai:google-genai:1.79.0)
# Feature flag to enable Gemini review engine (true/false)
GEMINI_ENABLED=false

# Google Developer API Key (obtain from https://aistudio.google.com/)
GOOGLE_API_KEY=

# Supported Gemini Models (verified against official Google Gen AI Developer API documentation):
# - gemini-2.5-flash (Recommended default: low latency, high throughput, strong structured reasoning)
# - gemini-2.0-flash
# - gemini-1.5-flash
GEMINI_MODEL=gemini-2.5-flash

# Execution controls and limits
AI_TIMEOUT_SECONDS=30
AI_MAX_INPUT_CHARS=50000
AI_MAX_OUTPUT_TOKENS=4096
AI_TEMPERATURE=0.2

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
